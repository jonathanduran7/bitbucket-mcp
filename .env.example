# Bitbucket Cloud API credentials (required)
# Create an API token in Atlassian account settings: https://id.atlassian.com/manage-profile/security/api-tokens
# Auth is Basic HTTP Auth using email:api_token — app passwords are deprecated (disabled 2026-06-09).
BITBUCKET_EMAIL=you@example.com
BITBUCKET_TOKEN=your-api-token-here

# Optional: override where profiles.json lives.
# Default: ${XDG_CONFIG_HOME:-~/.config}/bitbucket-mcp/profiles.json
#BITBUCKET_PROFILES_PATH=/custom/path/profiles.json

# Optional: process-level override for workspace resolution.
# Takes precedence over the active profile's default, but not over an explicit tool argument.
# Note: `repo` is always an explicit, required tool argument — it has no env override or profile default.
#BITBUCKET_WORKSPACE=my-workspace
